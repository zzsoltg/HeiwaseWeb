<div class="dialog-photo-wrapper">
    <picture class="dialog-photo">
      <source srcset="@((Member?.ImagePath ?? "img/logo.png").Replace(".webp", ".avif").Replace(".jpg", ".avif").Replace(".png", ".avif").Replace(".jfif", ".avif"))" type="image/avif">
      <source srcset="@((Member?.ImagePath ?? "img/logo.png").Replace(".avif", ".webp").Replace(".jpg", ".webp").Replace(".png", ".webp").Replace(".jfif", ".webp"))" type="image/webp">
      <img src="@((Member?.ImagePath ?? "img/logo.png").Replace(".avif", ".jpg").Replace(".webp", ".jpg").Replace(".png", ".jpg").Replace(".jfif", ".jpg"))" alt="@Member?.Name" loading="lazy">
    </picture>
</div>

<div class="dialog-header dialog-header-centered">
    <div>
        <h3 class="dialog-header-title">@Member?.Name</h3>
        <span class="dialog-eyebrow">@L["Competitor"]</span>
    </div>
</div>

<div class="result-dialog-title">
    <span class="dialog-badge">@Member?.Title</span>
</div>

<h4 class="dialog-section-title">@L["Accomplishments"]</h4>
<ul class="dialog-accomplishments">
    @foreach ( var accomplishment in Member?.Description ?? Enumerable.Empty<string>() )
    {
        <li><i class="fas fa-medal"></i> @accomplishment</li>
    }
</ul>
