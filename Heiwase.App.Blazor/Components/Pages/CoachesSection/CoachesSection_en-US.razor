@inherits CoachesSection

<h2 class="section-title-white">Our Instructors</h2>
<div class="about-grid about-grid-centered">
    <div class="card-common">
        <picture class="card-img">
          <source srcset="img/zoli.avif" type="image/avif">
          <source srcset="img/zoli.webp" type="image/webp">
          <img src="img/zoli.jpg" alt="Zoltán Stempel" loading="lazy">
        </picture>
        <div class="card-details">
            <h3 class="card-name">Zoltán Stempel</h3>
            <span class="card-rank">4th Dan, Head Instructor</span>
            <button type="button" class="btn-info" @onclick="OpenZoltanDialogAsync">Get to Know Me</button>
        </div>
    </div>
    <div class="card-common">
        <picture class="card-img">
          <source srcset="img/bendi.avif" type="image/avif">
          <source srcset="img/bendi.webp" type="image/webp">
          <img src="img/bendi.jpg" alt="Bendegúz Tálas" loading="lazy">
        </picture>
        <div class="card-details">
            <h3 class="card-name">Bendegúz Tálas</h3>
            <span class="card-rank">1st Dan, Instructor</span>
            <button type="button" class="btn-info" @onclick="OpenBendeguzDialogAsync">Get to Know Me</button>
        </div>
    </div>
    <div class="card-common">
        <picture class="card-img">
          <source srcset="img/barni.avif" type="image/avif">
          <source srcset="img/barni.webp" type="image/webp">
          <img src="img/barni.jpg" alt="Barnabás Benkó" loading="lazy">
        </picture>
        <div class="card-details">
            <h3 class="card-name">Barnabás Benkó</h3>
            <span class="card-rank">3rd Kyu, Instructor</span>
            <button type="button" class="btn-info" @onclick="OpenBarnabasDialogAsync">Get to Know Me</button>
        </div>
    </div>
</div>
