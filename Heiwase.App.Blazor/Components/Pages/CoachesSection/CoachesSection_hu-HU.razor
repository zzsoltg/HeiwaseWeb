@inherits CoachesSection

<h2 class="section-title-white">Edzõink</h2>
<div class="about-grid about-grid-centered">
    <div class="card-common">
        <picture class="card-img">
            <source srcset="https://heiwasemedia.blob.core.windows.net/public-media/img/zoli.avif" type="image/avif">
            <source srcset="https://heiwasemedia.blob.core.windows.net/public-media/img/zoli.webp" type="image/webp">
            <img src="https://heiwasemedia.blob.core.windows.net/public-media/img/zoli.jpg" alt="Stempel Zoltán" loading="lazy">
        </picture>
        <div class="card-details">
            <h3 class="card-name">Stempel Zoltán</h3>
            <span class="card-rank">4. dan, vezetõedzõ</span>
            <button type="button" class="btn-info" @onclick="OpenZoltanDialogAsync">Ismerj meg!</button>
        </div>
    </div>
    <div class="card-common">
        <picture class="card-img">
            <source srcset="https://heiwasemedia.blob.core.windows.net/public-media/img/bendi.avif" type="image/avif">
            <source srcset="https://heiwasemedia.blob.core.windows.net/public-media/img/bendi.webp" type="image/webp">
            <img src="https://heiwasemedia.blob.core.windows.net/public-media/img/bendi.jpg" alt="Tálas Bendegúz" loading="lazy">
        </picture>
        <div class="card-details">
            <h3 class="card-name">Tálas Bendegúz</h3>
            <span class="card-rank">1. dan, edzõ</span>
            <button type="button" class="btn-info" @onclick="OpenBendeguzDialogAsync">Ismerj meg!</button>
        </div>
    </div>
    <div class="card-common">
        <picture class="card-img">
            <source srcset="https://heiwasemedia.blob.core.windows.net/public-media/img/barni.avif" type="image/avif">
            <source srcset="https://heiwasemedia.blob.core.windows.net/public-media/img/barni.webp" type="image/webp">
            <img src="https://heiwasemedia.blob.core.windows.net/public-media/img/barni.jpg" alt="Benkó Barnabás" loading="lazy">
        </picture>
        <div class="card-details">
            <h3 class="card-name">Benkó Barnabás</h3>
            <span class="card-rank">3. kyu, edzõ</span>
            <button type="button" class="btn-info" @onclick="OpenBarnabasDialogAsync">Ismerj meg!</button>
        </div>
    </div>
</div>