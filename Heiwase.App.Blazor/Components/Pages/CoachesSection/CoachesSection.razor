<section id="coaches" class="section-padding coaches-section">
	<h2 class="section-title-white">Edzőink</h2>
	<div class="about-grid about-grid-centered">
		<div class="card-common">
			<img class="card-img" src="img/zoli.png" alt="Stempel Zoltán" />
			<div class="card-details">
				<h3 class="card-name">Stempel Zoltán</h3>
				<span class="card-rank">4. dan, vezetőedző</span>
				<button type="button" class="btn-info" @onclick="OpenZoltanDialogAsync">Ismerj meg!</button>
			</div>
		</div>
		<div class="card-common">
			<img class="card-img" src="img/bendi.png" alt="Tálas Bendegúz" />
			<div class="card-details">
				<h3 class="card-name">Tálas Bendegúz</h3>
				<span class="card-rank">1. dan, edző</span>
				<button type="button" class="btn-info" @onclick="OpenBendeguzDialogAsync">Ismerj meg!</button>
			</div>
		</div>
	</div>
</section>
