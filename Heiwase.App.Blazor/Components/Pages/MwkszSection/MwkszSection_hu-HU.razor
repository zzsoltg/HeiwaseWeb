@inherits MwkszSection

<div class="section-header section-header-medium-gap">
	<h2 class="heading-xl">Szövetségünk</h2>
	<p class="mwksz-intro-text">
		A Heiwase a Magyarországi Wado-ryu Karate Szövetség elkötelezett tagja.
		Az MWKSZ biztosítja klubunk számára a szakmai hátteret, és validációt,
		mindemellett a WUKF (World Union of Karate-do Federations) tagjaként lehetõséget
		biztosít csapatunknak a nemzetközi versenyzésre is, míg
		az IWKU (International Wado Karate Union) alapító tagjaként
		képzi tovább csapattagjainkat, Shibamori Kando (9. dan)
		nemzetközi fõinstruktor irányítása alatt. Vezetõje Rostás Tibor (7. dan).
	</p>
</div>

<div class="features-grid">
	<div class="feature-card">
		<i class="fas fa-graduation-cap feature-icon"></i>
		<h4>Övvizsgák</h4>
		<button type="button" class="btn-info" @onclick="OpenBeltExamDialogAsync">További információ</button>
	</div>
	<div class="feature-card">
		<i class="fas fa-campground feature-icon"></i>
		<h4>Edzõtáborok</h4>
		<button type="button" class="btn-info" @onclick="OpenTrainingCampDialogAsync">További információ</button>
	</div>
	<div class="feature-card">
		<i class="fas fa-trophy feature-icon"></i>
		<h4>Versenyek</h4>
		<button type="button" class="btn-info" @onclick="OpenCompetitionsDialogAsync">További információ</button>
	</div>
	<div class="feature-card">
		<i class="fas fa-globe-europe feature-icon"></i>
		<h4>Szemináriumok</h4>
		<button type="button" class="btn-info" @onclick="OpenSeminarsDialogAsync">További információ</button>
	</div>
</div>

<div class="gallery-collage">
	<picture class="gallery-img g-item-1">
	  <source srcset="img/mwkszgrid/csoport.avif" type="image/avif">
	  <source srcset="img/mwkszgrid/csoport.webp" type="image/webp">
	  <img src="img/mwkszgrid/csoport.jpg" alt="Leírás" loading="lazy">
	</picture>
	<picture class="gallery-img g-item-2">
	  <source srcset="img/mwkszgrid/katica.avif" type="image/avif">
	  <source srcset="img/mwkszgrid/katica.webp" type="image/webp">
	  <img src="img/mwkszgrid/katica.jpg" alt="Leírás" loading="lazy">
	</picture>
	<picture class="gallery-img g-item-3">
	  <source srcset="img/mwkszgrid/technika.avif" type="image/avif">
	  <source srcset="img/mwkszgrid/technika.webp" type="image/webp">
	  <img src="img/mwkszgrid/technika.jpg" alt="Leírás" loading="lazy">
	</picture>
	<picture class="gallery-img g-item-4">
	  <source srcset="img/mwkszgrid/verseny.avif" type="image/avif">
	  <source srcset="img/mwkszgrid/verseny.webp" type="image/webp">
	  <img src="img/mwkszgrid/verseny.jpg" alt="Leírás" loading="lazy">
	</picture>
</div>

<div class="event-calendar-wrapper">
	<picture class="event-calendar-image">
	  <source srcset="img/esemenynaptar26.avif" type="image/avif">
	  <source srcset="img/esemenynaptar26.webp" type="image/webp">
	  <img src="img/esemenynaptar26.jpg" alt="Leírás" loading="lazy">
	</picture>
</div>