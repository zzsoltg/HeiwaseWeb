@inherits MwkszSection

<div class="section-header section-header-medium-gap">
	<h2 class="heading-xl">Our Federation</h2>
	<p class="mwksz-intro-text">
		Heiwase is a dedicated member of the Hungarian Wado-ryu Karate Federation.
		The MWKSZ provides our club with a robust professional foundation and official validation.
		Furthermore, as a member of the WUKF (World Union of Karate-do Federations), it grants our team
		the opportunity to compete on the international stage, while as a founding member of
		the IWKU (International Wado Karate Union), it facilitates the advanced training of our practitioners
		under the expert guidance of International Chief Instructor Shibamori Kando (9th Dan).
		The federation is led by Tibor Rostás (7th Dan).
	</p>
</div>
<div class="features-grid">
	<div class="feature-card">
		<i class="fas fa-graduation-cap feature-icon"></i>
		<h4>Belt Examinations</h4>
		<button type="button" class="btn-info" @onclick="OpenBeltExamDialogAsync">Learn More</button>
	</div>
	<div class="feature-card">
		<i class="fas fa-campground feature-icon"></i>
		<h4>Training Camps</h4>
		<button type="button" class="btn-info" @onclick="OpenTrainingCampDialogAsync">Learn More</button>
	</div>
	<div class="feature-card">
		<i class="fas fa-trophy feature-icon"></i>
		<h4>Tournaments</h4>
		<button type="button" class="btn-info" @onclick="OpenCompetitionsDialogAsync">Learn More</button>
	</div>
	<div class="feature-card">
		<i class="fas fa-globe-europe feature-icon"></i>
		<h4>Seminars</h4>
		<button type="button" class="btn-info" @onclick="OpenSeminarsDialogAsync">Learn More</button>
	</div>
</div>
<div class="gallery-collage">
	<img src="img/mwkszgrid/csoport.jpg" class="gallery-img g-item-1" />
	<img src="img/mwkszgrid/katica.jpg" class="gallery-img g-item-2" />
	<img src="img/mwkszgrid/technika.jpg" class="gallery-img g-item-3" />
	<img src="img/mwkszgrid/verseny.jpg" class="gallery-img g-item-4" />
</div>