@inherits HallOfFameSection

@if (_competitors == null || _competitors.Count == 0)
{
	<p class="text-center">Loading data...</p>
}
else
{
	<h3 class="section-subtitle-white">Distinguished Competitors</h3>
	<div class="slider-wrapper">
		<button class="slider-nav-btn" @onclick="OnCompetitorRightClick" aria-label="Previous">
			<i class="fas fa-chevron-left"></i>
		</button>
		<div class="slider-container">
			<div id="competitors-grid" class="slider-grid">
				@foreach (var member in GetCompetitorItems())
				{
					<div class="card-common">
						<img class="card-img" src="@member.ImagePath" alt="@member.Name"
							 onerror="this.src='https://via.placeholder.com/300x300/3533cd/ffffff?text=No+Image';" />
						<div class="card-details">
							<h3 class="card-name">@member.Name</h3>
							<span class="card-rank">@member.Title</span>
							<button type="button" class="btn-info" @onclick="() => OpenCompetitorResultsDialogAsync(member)">Achievements</button>
						</div>
					</div>
				}
			</div>
		</div>
		<button class="slider-nav-btn" @onclick="OnCompetitorLeftClick" aria-label="Next">
			<i class="fas fa-chevron-right"></i>
		</button>
	</div>
}

@if (_senpais != null && _senpais.Count > 0)
{
	<h3 class="section-subtitle-white section-subtitle-top-gap">Senior Students</h3>
	<div class="slider-wrapper">
		<button class="slider-nav-btn" @onclick="OnSenpaiRightClick" aria-label="Previous">
			<i class="fas fa-chevron-left"></i>
		</button>
		<div class="slider-container">
			<div id="senpais-grid" class="slider-grid">
				@foreach (var member in GetSenpaiItems())
				{
					<div class="card-common">
						<img class="card-img" src="@member.ImagePath" alt="@member.Name"
							 onerror="this.src='https://via.placeholder.com/300x300/cb6ce6/ffffff?text=No+Image';" />
						<div class="card-details">
							<h3 class="card-name">@member.Name</h3>
							<span class="card-rank">@member.Title</span>
							<button type="button" class="btn-info" @onclick="() => OpenSenpaiResultsDialogAsync(member)">Achievements</button>
						</div>
					</div>
				}
			</div>
		</div>
		<button class="slider-nav-btn" @onclick="OnSenpaiLeftClick" aria-label="Next">
			<i class="fas fa-chevron-right"></i>
		</button>
	</div>
}