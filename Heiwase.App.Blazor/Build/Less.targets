<Project>
  <ItemGroup>
	<!-- Files/folders starting with "_" are LESS partials (e.g. Styles\_variables.less) meant to be
		 @import-ed, not compiled to their own .css file. -->
	<LessFile Include="**\*.less" Exclude="bin\**;obj\**;Build\**;**\_*\**;**\_*.less" />
  </ItemGroup>

  <UsingTask TaskName="CompileLessFiles" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
	<ParameterGroup>
	  <LessFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
	</ParameterGroup>
	<Task>
	  <Reference Include="$(NuGetPackageRoot)microsoft.extensions.dependencyinjection.abstractions\2.1.1\lib\netstandard2.0\Microsoft.Extensions.DependencyInjection.Abstractions.dll" />
	  <Reference Include="$(NuGetPackageRoot)microsoft.extensions.dependencyinjection\2.1.1\lib\netstandard2.0\Microsoft.Extensions.DependencyInjection.dll" />
	  <Reference Include="$(NuGetPackageRoot)system.drawing.common\4.5.0\lib\netstandard2.0\System.Drawing.Common.dll" />
	  <Reference Include="$(Pkgdotless_Core)\lib\netstandard2.0\dotless.Core.dll" />
	  <Using Namespace="System.IO" />
	  <Using Namespace="System.Text" />
	  <Using Namespace="dotless.Core" />
	  <Using Namespace="dotless.Core.configuration" />
	  <Code Type="Fragment" Language="cs">
		<![CDATA[
		  foreach (var item in LessFiles)
		  {
			  string lessPath = item.GetMetadata("FullPath");
			  string cssPath = Path.ChangeExtension(lessPath, ".css");

			  string lessContent = File.ReadAllText(lessPath);

			  var configuration = new DotlessConfiguration
			  {
				  MinifyOutput = false,
				  CacheEnabled = false,
				  KeepFirstSpecialComment = false
			  };
			  var engine = new EngineFactory(configuration).GetEngine();
			  engine.CurrentDirectory = Path.GetDirectoryName(lessPath);
			  string css = engine.TransformToCss(lessContent, lessPath);

			  // Match the UTF-8 BOM encoding used by the original .css files so diffs stay minimal.
			  File.WriteAllText(cssPath, css, new UTF8Encoding(true));

			  Log.LogMessage(MessageImportance.Low, "Compiled LESS '" + lessPath + "' -> '" + cssPath + "'");
		  }
		]]>
	  </Code>
	</Task>
  </UsingTask>

  <Target Name="CompileLess" BeforeTargets="BeforeBuild" Inputs="@(LessFile)" Outputs="@(LessFile->'%(RootDir)%(Directory)%(Filename).css')" Condition="'@(LessFile)' != ''">
	<CompileLessFiles LessFiles="@(LessFile)" />
  </Target>

</Project>
