@inherits TimetableSection

<div class="schedule-box">
    <h3 class="schedule-title">Training Schedule</h3>
    <p class="schedule-intro-text">
        We host 12 training sessions per week at our club, allowing you to choose from 4 different training programs and 2 age groups.
        The programs can be seamlessly combined, meaning your training week is limited only by your free time and determination.
        Come visit us, experience a session firsthand, and become a member of Heiwase Karate Szeged!
    </p>
    <div class="schedule-table-wrapper">
        <table class="schedule-table">
            <tbody>
                <tr class="feature-card">
                    <th scope="row">Monday</th>
                    <td data-label="Children's Wado-ryu">16:30 - 18:00</td>
                    <td data-label="Adult Wado-ryu">18:00 - 19:30</td>
                </tr>
                <tr class="feature-card feature-card-delay-02">
                    <th scope="row">Tuesday</th>
                    <td data-label="Children's Wado-ryu">16:00 - 17:30</td>
                    <td data-label="Sport Karate">17:30 - 19:00</td>
                    <td data-label="Adult Wado-ryu">19:00 - 20:30</td>
                </tr>
                <tr class="feature-card feature-card-delay-04">
                    <th scope="row">Wednesday</th>
                    <td data-label="Children's Wado-ryu">16:30 - 18:00</td>
                    <td data-label="Adult Wado-ryu">18:00 - 19:30</td>
                </tr>
                <tr class="feature-card feature-card-delay-06">
                    <th scope="row">Thursday</th>
                    <td data-label="Athletic Conditioning">16:30 - 17:30</td>
                    <td data-label="Sport Karate">17:30 - 19:00</td>
                    <td data-label="Women's Self-Defense">19:00 - 20:00</td>
                </tr>
                <tr class="feature-card feature-card-delay-08">
                    <th scope="row">Friday</th>
                    <td data-label="Children's Wado-ryu">16:30 - 18:00</td>
                    <td data-label="Adult Wado-ryu">18:00 - 19:30</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>