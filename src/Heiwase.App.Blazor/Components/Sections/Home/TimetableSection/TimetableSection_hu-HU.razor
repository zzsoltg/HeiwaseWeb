@inherits TimetableSection

<div class="schedule-box">
    <h3 class="schedule-title">Edzésrend</h3>
    <p class="schedule-intro-text">
        Egyesületünkben 12 db edzést tartunk egy héten, 4 edzéstípusból és 2 korosztályból is választhatsz.
        A típusok kombinálhatóak, így az edzéshetednek csak a szabadidőd és az elszántságod szab határt.
        Gyere el, nézd meg, próbáld ki, és legyél te is a Heiwase Karate Szeged tagja!
    </p>
    <div class="schedule-table-wrapper">
        <table class="schedule-table">
            <tbody>
                <tr class="feature-card">
                    <th scope="row">Hétfő</th>
                    <td data-label="Wado-ryu gyerek">16:30 - 18:00</td>
                    <td data-label="Wado-ryu felnőtt">18:00 - 19:30</td>
                </tr>
                <tr class="feature-card feature-card-delay-02">
                    <th scope="row">Kedd</th>
                    <td data-label="Wado-ryu gyerek">16:00 - 17:30</td>
                    <td data-label="Sportkarate">17:30 - 19:00</td>
                    <td data-label="Wado-ryu felnőtt">19:00 - 20:30</td>
                </tr>
                <tr class="feature-card feature-card-delay-04">
                    <th scope="row">Szerda</th>
                    <td data-label="Wado-ryu gyerek">16:30 - 18:00</td>
                    <td data-label="Wado-ryu felnőtt">18:00 - 19:30</td>
                </tr>
                <tr class="feature-card feature-card-delay-06">
                    <th scope="row">Csütörtök</th>
                    <td data-label="Atlétika">16:30 - 17:30</td>
                    <td data-label="Sportkarate">17:30 - 19:00</td>
                    <td data-label="Női önvédelem">19:00 - 20:00</td>
                </tr>
                <tr class="feature-card feature-card-delay-08">
                    <th scope="row">Péntek</th>
                    <td data-label="Wado-ryu gyerek">16:30 - 18:00</td>
                    <td data-label="Wado-ryu felnőtt">18:00 - 19:30</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
