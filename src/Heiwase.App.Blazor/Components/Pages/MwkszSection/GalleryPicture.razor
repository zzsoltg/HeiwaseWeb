<picture class="gallery-img gallery-grid-item @Image.GridItemClass" @onclick="OpenImageDialog">
	@if (!Image.IsPlaceholder)
	{
		<source srcset="@Path.ChangeExtension(Image.Source, ".avif")" type="image/avif">
		<source srcset="@Path.ChangeExtension(Image.Source, ".webp")" type="image/webp">
		<img src="@Path.ChangeExtension(Image.Source, ".jpg")" alt="@AltText" loading="lazy">
	}
	else
	{
		<img src="@Image.Source" alt="@AltText" loading="lazy">
	}
</picture>
