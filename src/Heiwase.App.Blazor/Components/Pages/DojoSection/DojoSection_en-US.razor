@inherits DojoSection
<div class="dojo-section-overlay section-padding">
    <div class="section-header section-header-large-gap">
        <h2 class="heading-xl">The Heiwase Dojo</h2>
        <p class="about-intro-text text-light">
            Our team warmly welcomes those eager to train in our exclusive 86-square-meter facility. Your ongoing development is assured by professional-grade equipment, a fully tatami-matted training area, and our highly experienced instructors.
        </p>
    </div>

    <div class="dojo-grid">
        <div class="dojo-info-panel">
            <div class="info-bubble dojo-bubble">
                <div class="dojo-card-header">
                    <span class="dojo-icon">📍</span>
                    <h3>Location</h3>
                </div>
                <div class="dojo-address-content">
                    <p class="dojo-bold-text">Heiwase Karate Szeged</p>
                    <p>6722 Szeged, Földváry utca 3.</p>
                    <p class="dojo-note">
                        Located in the heart of downtown, just a few steps from the university... <br>
                        Easily accessible by public transport, featuring excellent parking options and nearby bicycle storage.
                    </p>
                </div>
                <div class="dojo-video-dialog">
                    <button type="button" class="btn-design">Watch Our Introductory Video!</button>
                </div>
            </div>

            <div class="info-bubble dojo-bubble mt-30">
                <div class="dojo-card-header">
                    <span class="dojo-icon">🥋</span>
                    <h3>Why Train With Us?</h3>
                </div>
                <ul class="dojo-features">
                    <li>A dedicated private facility offering 12 training sessions weekly</li>
                    <li>Premium quality tatami-matted flooring</li>
                    <li>Specialized equipment to enhance stamina, flexibility, and overall strength</li>
                    <li>Prime location with exceptional accessibility</li>
                </ul>
            </div>
        </div>

        <div class="dojo-schedule-panel">
            <div class="schedule-box card-common">
                <h3 class="schedule-title">Training Schedule</h3>
                <div class="schedule-table-wrapper">
                    <table class="schedule-table">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Children's Wado-ryu</th>
                                <th>Adult Wado-ryu</th>
                                <th>Sport Karate</th>
                                <th>Athletic Conditioning</th>
                                <th>Women's Self-Defense</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th>Monday</th>
                                <td>16:30 - 18:00</td>
                                <td>18:00 - 19:30</td>
                                <td></td>
                                <td></td>
                                <td></td>
                            </tr>
                            <tr>
                                <th>Tuesday</th>
                                <td>16:00 - 17:30</td>
                                <td>19:00 - 20:30</td>
                                <td>17:30 - 19:00</td>
                                <td></td>
                                <td></td>
                            </tr>
                            <tr>
                                <th>Wednesday</th>
                                <td>16:30 - 18:00</td>
                                <td>18:00 - 19:30</td>
                                <td></td>
                                <td></td>
                                <td></td>
                            </tr>
                            <tr>
                                <th>Thursday</th>
                                <td></td>
                                <td></td>
                                <td>17:30 - 19:00</td>
                                <td>16:30 - 17:30</td>
                                <td>19:00 - 20:00</td>
                            </tr>
                            <tr>
                                <th>Friday</th>
                                <td>16:30 - 18:00</td>
                                <td>18:00 - 19:30</td>
                                <td></td>
                                <td></td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-common map-placeholder mt-30">
                <div class="map-overlay">
                    <span class="map-title">Loading map...</span>
                    <button type="button" class="btn-info">Get Directions</button>
                </div>
            </div>
        </div>
    </div></div>