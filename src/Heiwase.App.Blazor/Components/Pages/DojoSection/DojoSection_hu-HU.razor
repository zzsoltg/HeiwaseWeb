@inherits DojoSection

<div class="dojo-section-overlay section-padding">
    <div class="section-header section-header-large-gap">
        <h2 class="heading-xl">A Heiwase Dojo</h2>
        <p class="about-intro-text text-light">
            Csapatunk saját edzőtermében, 86 m2-en várja az edzeni vágyókat. A fejlődésedről professzionális felszerelések, tatamis terem
            és tapasztalt edzők gondoskodnak.
        </p>
    </div>

    <div class="dojo-grid">
        <div class="dojo-info-panel">
            <div class="info-bubble dojo-bubble">
                <div class="dojo-card-header">
                    <span class="dojo-icon">📍</span>
                    <h3>Helyszín</h3>
                </div>
                <div class="dojo-address-content">
                    <p class="dojo-bold-text">Heiwase Karate Szeged</p>
                    <p>6722 Szeged, Földváry utca 3.</p>
                    <p class="dojo-note">
                        A Belváros szívében, az egyetemtől pár lépésre... <br>
                        Könnyen megközelíthető tömegközlekedéssel, kiváló parkolási lehetőséggel és biciklitárolóval a közelben.
                    </p>
                </div>
                <div class="dojo-video-dialog">
                    <button type="button" class="btn-design">Nézd meg bemutató videónkat!</button>
                </div>
            </div>

            <div class="info-bubble dojo-bubble mt-30">
                <div class="dojo-card-header">
                    <span class="dojo-icon">🥋</span>
                    <h3>Miért érdemes nálunk edzeni?</h3>
                </div>
                <ul class="dojo-features">
                    <li>Saját terem, heti 12 edzéssel</li>
                    <li>Minőségi tatamival fedett talaj</li>
                    <li>Állóképességet, rugalmasságot és erőnlétet fejlesztő eszközök</li>
                    <li>Kiváló elhelyezkedés és megközelítés</li>
                </ul>
            </div>
        </div>

        <div class="dojo-schedule-panel">
            <div class="schedule-box card-common">
                <h3 class="schedule-title">Edzésrend</h3>
                <div class="schedule-table-wrapper">
                    <table class="schedule-table">
                        <thead>
                            <tr>
                                <th aria-hidden="true"></th>
                                <th scope="col">Wado-ryu gyerek</th>
                                <th scope="col">Wado-ryu felnőtt</th>
                                <th scope="col">Sportkarate</th>
                                <th scope="col">Atlétika</th>
                                <th scope="col">Női önvédelem</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">Hétfő</th>
                                <td data-label="Wado-ryu gyerek">16:30 - 18:00</td>
                                <td data-label="Wado-ryu felnőtt">18:00 - 19:30</td>
                                <td data-label="Sportkarate"></td>
                                <td data-label="Atlétika"></td>
                                <td data-label="Női önvédelem"></td>
                            </tr>
                            <tr>
                                <th scope="row">Kedd</th>
                                <td data-label="Wado-ryu gyerek">16:00 - 17:30</td>
                                <td data-label="Wado-ryu felnőtt">19:00 - 20:30</td>
                                <td data-label="Sportkarate">17:30 - 19:00</td>
                                <td data-label="Atlétika"></td>
                                <td data-label="Női önvédelem"></td>
                            </tr>
                            <tr>
                                <th scope="row">Szerda</th>
                                <td data-label="Wado-ryu gyerek">16:30 - 18:00</td>
                                <td data-label="Wado-ryu felnőtt">18:00 - 19:30</td>
                                <td data-label="Sportkarate"></td>
                                <td data-label="Atlétika"></td>
                                <td data-label="Női önvédelem"></td>
                            </tr>
                            <tr>
                                <th scope="row">Csütörtök</th>
                                <td data-label="Wado-ryu gyerek"></td>
                                <td data-label="Wado-ryu felnőtt"></td>
                                <td data-label="Sportkarate">17:30 - 19:00</td>
                                <td data-label="Atlétika">16:30 - 17:30</td>
                                <td data-label="Női önvédelem">19:00 - 20:00</td>
                            </tr>
                            <tr>
                                <th scope="row">Péntek</th>
                                <td data-label="Wado-ryu gyerek">16:30 - 18:00</td>
                                <td data-label="Wado-ryu felnőtt">18:00 - 19:30</td>
                                <td data-label="Sportkarate"></td>
                                <td data-label="Atlétika"></td>
                                <td data-label="Női önvédelem"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-common map-placeholder mt-30">
                <div class="map-overlay">
                    <span class="map-title">Térkép betöltése...</span>
                    <button type="button" class="btn-info">Útvonaltervezés</button>
                </div>
            </div>
        </div>
    </div>
</div>
